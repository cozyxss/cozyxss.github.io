<!DOCTYPE html>
{%- set t = i18n[lang] %}{%- set px = t.prefix %}
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0b0b0c">
{% set pageTitle = (title + " · " + site.title) if title else (site.title + " | " + site.subtitle) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ summary or t.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="{{ t.otherLang }}" href="{{ site.url }}{{ page.url | altUrl(lang) }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ summary or t.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ 'article' if no else 'website' }}">
{% if cover %}<meta property="og:image" content="{{ site.url }}{{ cover }}">
<meta name="twitter:card" content="summary_large_image">{% else %}<meta name="twitter:card" content="summary">{% endif %}
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/icon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/assets/icon-180.png">
<link rel="preload" href="/assets/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/fonts.css">
<script>
  // Set theme before paint to avoid a flash
  (function () {
    var t = null;
    try { t = localStorage.getItem("theme"); } catch (e) {}
    if (t !== "light" && t !== "dark") t = "dark";
    document.documentElement.dataset.theme = t;
  })();
</script>
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="ticker"><div class="wrap"><span class="who">{% include "syms.njk" %}</span><span class="sl">//</span><span>{{ t.ticker }}</span></div></div>
<header class="site-header wrap">
  <div class="brand-row">
    <a class="brand" href="{{ px }}/" aria-label="cozyxss home">
      <span class="brand-name">{{ site.title }}</span><span class="cursor" aria-hidden="true">_</span>
    </a>
    <div class="head-tools">
    <a class="lang-switch" href="{{ page.url | altUrl(lang) }}" hreflang="{{ t.otherLang }}" lang="{{ t.otherLang }}" title="{{ t.switchLabel }}"><span class="globe" aria-hidden="true">🌐</span><span class="lang-code">{{ t.otherLangName }}</span></a>
    <button class="theme-toggle" type="button" aria-label="Switch between screen and paper mode" title="screen / paper">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
    </button>
    </div>
  </div>
  <p class="tagline"><span class="prompt">&gt;</span> {{ t.tagline }}</p>
  <nav class="cat-nav" aria-label="Sections">
    <a href="{{ px }}/" {% if page.url == px + '/' %}aria-current="page"{% endif %}>{{ t.navAll }}</a>
    <a href="{{ px }}/web-vulnerabilities/" {% if (px + '/web-vulnerabilities/') in page.url %}aria-current="page"{% endif %}>{{ t.navVulns }}</a>
    <a href="{{ px }}/burp/" {% if page.url == px + '/burp/' %}aria-current="page"{% endif %}>{{ t.navBurp }}</a>
    <a href="{{ px }}/tags/" {% if page.url == px + '/tags/' %}aria-current="page"{% endif %}>{{ t.navTags }}</a>
    <a href="{{ px }}/about/" {% if page.url == px + '/about/' %}aria-current="page"{% endif %}>{{ t.navAbout }}</a>
  </nav>
</header>

<main id="main" class="wrap">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap foot-inner">
    <div class="sig">
      {% set avatarClass = "av-foot" %}{% include "avatar.njk" %}
      <div>
        <p class="sig-name">betul {% include "syms.njk" %}</p>
        <p>© {{ build.year }} cozyxss · stay curious, stay in scope.</p>
      </div>
    </div>
    <div class="foot-links">
      <a href="{{ site.links.github }}">github</a>
      <a href="{{ site.links.x }}">x</a>
      <a href="{{ site.links.medium }}">medium</a>
      <a href="{{ site.links.linkedin }}">linkedin</a>
      <a href="/feed.xml">rss</a>
    </div>
  </div>
  <div class="ticker" aria-hidden="true"><div class="wrap"><span>{{ t.tickerFoot }}</span></div></div>
</footer>
<script src="/assets/js/site.js" defer></script>
</body>
</html>
