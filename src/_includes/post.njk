---
layout: base.njk
---
{%- set t = i18n[lang] %}{%- set px = t.prefix %}
{%- set list = collections | coll("posts", lang) %}
{%- set nx = list | getPreviousCollectionItem(page) -%}
{%- set pv = list | getNextCollectionItem(page) -%}
<article class="post">
  <header class="post-head">
    <a class="back" href="{{ px }}/">{{ t.back }}</a>
    <div class="bar">
      {%- if no is defined %}<span class="no">{{ no | pad }}</span><span class="sl">//</span>{% endif %}
      <time datetime="{{ page.date | isoDate }}">{{ page.date | date(t.locale) }}</time>
      <span class="sl">//</span><span>{{ content | readTime }} {{ t.minRead }}</span>
      {%- if series %}<span class="sl">//</span><a href="{{ px }}/web-vulnerabilities/{{ series | slug2 }}/">{{ series }} {{ part | pad2 }}</a>{% endif %}
    </div>
    <h1>{{ title }}</h1>
    {%- if summary %}<p class="post-lede"><span class="prompt">&gt;</span> {{ summary }}</p>{% endif %}
  </header>

  {%- if cover %}
  <figure class="post-cover crt-img"><img src="{{ cover }}" alt="{{ coverAlt or '' }}"></figure>
  {%- endif %}

  <div class="prose">
{{ content | safe }}
  </div>

  {%- set tl = tags | realTags %}
  {%- if tl.length %}
  <p class="post-tags">
    {%- for tg in tl %}<a href="{{ px }}/tags/#{{ tg | slug2 }}">{{ tg }}</a>{% endfor -%}
  </p>
  {%- endif %}

  <div class="post-actions">
    <div class="clap">
      <span class="clap-hint">{{ t.likedIt | replace(">", "&gt;") | safe }}</span>
      <applause-button multiclap="true" url="cozyxss.com{{ page.url }}"></applause-button>
    </div>
    <button class="copy-link" type="button" data-url="{{ site.url }}{{ page.url }}">{{ t.copyLink }}</button>
  </div>

  <div class="byline">
    {% set avatarClass = "av-byline" %}{% include "avatar.njk" %}
    <p><span class="muted">{{ t.writtenBy }}</span> betul {% include "syms.njk" %}<br><span class="muted">{{ t.aka }}</span></p>
  </div>

  <nav class="post-nav" aria-label="More posts">
    {%- if nx %}
    <a class="next" href="{{ nx.url }}"><span>{{ t.newer }}</span>{{ nx.data.title }}</a>
    {%- endif %}
    {%- if pv %}
    <a class="prev" href="{{ pv.url }}"><span>{{ t.older }}</span>{{ pv.data.title }}</a>
    {%- endif %}
  </nav>

  <section class="comments" aria-label="Comments">
    <h2><span class="prompt">&gt;</span> {{ t.comments }}</h2>
    {%- if site.giscus.repoId and site.giscus.categoryId %}
    <div class="giscus"></div>
    <script>
      (function () {
        var s = document.createElement("script");
        var attrs = {
          src: "https://giscus.app/client.js",
          "data-repo": "{{ site.giscus.repo }}",
          "data-repo-id": "{{ site.giscus.repoId }}",
          "data-category": "{{ site.giscus.category }}",
          "data-category-id": "{{ site.giscus.categoryId }}",
          "data-mapping": "pathname",
          "data-strict": "1",
          "data-reactions-enabled": "1",
          "data-emit-metadata": "0",
          "data-input-position": "top",
          "data-theme": document.documentElement.dataset.theme === "dark" ? "transparent_dark" : "light",
          "data-lang": "{{ lang }}",
          "data-loading": "lazy",
          crossorigin: "anonymous"
        };
        for (var k in attrs) s.setAttribute(k, attrs[k]);
        s.async = true;
        document.currentScript.parentNode.appendChild(s);
      })();
    </script>
    {%- else %}
    <p class="muted">{{ t.commentsSoon }}</p>
    {%- endif %}
  </section>
</article>
<link rel="stylesheet" href="/assets/vendor/applause-button.css">
<script src="/assets/vendor/applause-button.js" defer></script>
