---
layout: base.njk
title: web vulnerabilities
permalink: /web-vulnerabilities/
---
{%- set limit = 3 %}
<h1 class="list-title">web vulnerabilities</h1>
<p class="tagline" style="margin-bottom:2.2rem"><span class="prompt">&gt;</span> Zafiyet türlerine göre notlarım, konu konu ve sırayla.</p>
{%- for s in collections.seriesList %}
<section class="tag-group" id="{{ s.slug }}" style="margin-bottom:3.5rem">
  <h2><a href="/web-vulnerabilities/{{ s.slug }}/" style="color:inherit;text-decoration:none">{{ loop.index | pad2 }} // {{ s.name }}</a> <span class="count" style="font-size:.8rem;opacity:.6;margin-left:.5rem">{{ s.posts.length }} note{% if s.posts.length != 1 %}s{% endif %}</span></h2>
  <div class="post-list" style="margin-top:1.2rem">
  {%- for post in (s.posts | reverse | head(limit)) %}
  {% include "postcard.njk" %}
  {%- endfor %}
  </div>
  {%- if s.posts.length > limit %}
  <p style="text-align:right;margin-top:1rem"><a class="more" href="/web-vulnerabilities/{{ s.slug }}/">tüm {{ s.name }} notları ({{ s.posts.length }}) →</a></p>
  {%- endif %}
</section>
{%- endfor %}
